#ifndef LIGHTING_H
#define LIGHTING_H

#define LIGHTING_MAX_SPECULAR_EXP 512.0f

#define LIGHT_TYPE_DIRECTIONAL 0
#define LIGHT_TYPE_POINT 1
#define LIGHT_TYPE_SPOT 2

struct Light {
    float3 color;
    float3 direction;
    float3 position;
    uint type;
    float intensity;
    float range;
    float spot_angle_diff;
}

struct SurfaceData {
    float3 normal;
    float3 color;
    float3 position;
    float roughness;
    float metalness;
}

namespace Lighting {
    // === other helpers ==================================

    float attenuate(Light light, float3 frag_world_pos) {
        float dist = distance(light.position, frag_world_pos);
        float att = saturate(1.0f - (dist * dist / (light.range * light.range)));
        return att * att;
    }

    // === old lighting formulas ==========================

    float3 lambert_diffuse(Light light, SurfaceData surface, float3 dir_to_light) {
        float scalar = max(dot(dir_to_light, surface.normal), 0.0);
        return surface.color * scalar * light.intensity * light.color;
    }

    float3 blinn_phong_specular(Light light, SurfaceData surface, float3 camera_pos, float3 dir_to_light) {
        float3 to_cam = normalize(camera_pos - surface.position);
        float3 refl = reflect(-dir_to_light, surface.normal);

        float specular_exp = (1.0f - surface.roughness) * LIGHTING_MAX_SPECULAR_EXP;

        float3 specular_term =
            pow(max(dot(refl, to_cam), 0), specular_exp) *
            light.intensity *
            light.color;

        specular_term = specular_exp > 0.01f ? specular_term : float3(0.0f);

        return specular_term;
    }

    // === combined light functions =======================

    float3 shade_retro_directional(Light light, SurfaceData surface, float3 camera_pos) {
        float3 color = float3(0.0f);

        color += lambert_diffuse(light, surface, -light.direction);
        color += blinn_phong_specular(light, surface, camera_pos, -light.direction);

        return color;
    }

    float3 shade_retro_point(Light light, SurfaceData surface, float3 camera_pos) {
        float3 color = float3(0.0f);

        float3 to_light = normalize(light.position - surface.position);
        color += lambert_diffuse(light, surface, to_light);
        color += blinn_phong_specular(light, surface, camera_pos, to_light);
        color *= attenuate(light, surface.position);

        return color;
    }

    float3 shade_retro(Light light, SurfaceData surface, float3 camera_pos) {
        float3 color = float3(0.0f);
        color = shade_retro_point(light, surface, camera_pos);

        // switch (light.type) {
        //     case LIGHT_TYPE_DIRECTIONAL: 
        //         color = shade_retro_directional(light, surface, camera_pos);
        //         break;
        //     case LIGHT_TYPE_POINT:
        //         color = shade_retro_point(light, surface, camera_pos);
        //         break;
        // }

        return color;
    }

    // float3 shade_pbr(Light light, float3 surface_color, float3 surface_normal) {
    // }
}

#endif
